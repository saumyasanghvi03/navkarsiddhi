<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warm cream base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFDF7"
                android:endColor="#FFF3DC"
                android:angle="135" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Saffron top-left glow -->
    <item android:right="60dp" android:bottom="60dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30F97316"
                android:endColor="#00F97316"
                android:angle="315" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
