<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mala_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Header: label + today count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NAVKAR MANTRA"
            android:textColor="#C2410C"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/mala_navkars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#EA580C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="today"
            android:textColor="#B45309"
            android:textSize="8sp" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="#FDE68A" />

    <!-- Mantra line 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="𑀡𑀫𑁄  Namo Arihantāṇam"
            android:textColor="#1A0A00"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/mala_count_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="×—"
            android:textColor="#F97316"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mantra line 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="𑀡𑀫𑁄  Namo Siddhāṇam"
            android:textColor="#1A0A00"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/mala_count_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="×—"
            android:textColor="#F97316"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mantra line 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="𑀡𑀫𑁄  Namo Āyariyāṇam"
            android:textColor="#1A0A00"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/mala_count_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="×—"
            android:textColor="#F97316"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mantra line 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="𑀡𑀫𑁄  Namo Uvajjhāyāṇam"
            android:textColor="#1A0A00"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/mala_count_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="×—"
            android:textColor="#F97316"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mantra line 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="𑀡𑀫𑁄  Namo Loe Savva Sāhūṇam"
            android:textColor="#1A0A00"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/mala_count_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="×—"
            android:textColor="#F97316"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Footer: malas + streak -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#FDE68A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mala_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📿  — Malas"
            android:textColor="#92400E"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/mala_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥  — day streak"
            android:textColor="#92400E"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
