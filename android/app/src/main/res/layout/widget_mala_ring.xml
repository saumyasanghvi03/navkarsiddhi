<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mala_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- LEFT: stats -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY"
                android:textColor="#F97316"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <!-- Big navkar count -->
            <TextView
                android:id="@+id/mala_navkars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="—"
                android:textColor="#FFF1E0"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Navkars"
                android:textColor="#BF9070"
                android:textSize="10sp"
                android:letterSpacing="0.05" />

            <!-- Divider -->
            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#5C2E1A" />

            <TextView
                android:id="@+id/mala_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📿  — Malas"
                android:textColor="#BF9070"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/mala_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🔥  — day streak"
                android:textColor="#BF9070"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#3D1F10" />

        <!-- RIGHT: bead grid -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 3 rows of 9 beads = 27 beads visible -->
            <TextView
                android:id="@+id/mala_bead_row1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● ● ● ● ● ● ● ● ●"
                android:textColor="#F97316"
                android:textSize="10sp"
                android:gravity="center"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/mala_bead_row2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="● ● ● ● ● ● ● ● ●"
                android:textColor="#F97316"
                android:textSize="10sp"
                android:gravity="center"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/mala_bead_row3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="○ ○ ○ ○ ○ ○ ○ ○ ○"
                android:textColor="#5C2E1A"
                android:textSize="10sp"
                android:gravity="center"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/mala_bead_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mala 1"
                android:textColor="#F5A623"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/mala_in_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="in progress"
                android:textColor="#7A3D1F"
                android:textSize="8sp"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
