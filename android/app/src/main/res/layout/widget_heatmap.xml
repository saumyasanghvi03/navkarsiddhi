<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_heatmap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📿  THIS WEEK"
            android:textColor="#F97316"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/heatmap_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#92400E"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 7 day squares — flat horizontal, NO nested weights -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="7">

        <!-- Day 0 (oldest) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <View
                android:id="@+id/heatmap_bar_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/heatmap_bar_empty" />
        </FrameLayout>

        <!-- Day 1 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <View
                android:id="@+id/heatmap_bar_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/heatmap_bar_empty" />
        </FrameLayout>

        <!-- Day 2 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <View
                android:id="@+id/heatmap_bar_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/heatmap_bar_empty" />
        </FrameLayout>

        <!-- Day 3 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <View
                android:id="@+id/heatmap_bar_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/heatmap_bar_low" />
        </FrameLayout>

        <!-- Day 4 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <View
                android:id="@+id/heatmap_bar_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/heatmap_bar_mid" />
        </FrameLayout>

        <!-- Day 5 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <View
                android:id="@+id/heatmap_bar_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/heatmap_bar_mid" />
        </FrameLayout>

        <!-- Day 6 (today) — brightest orange -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <View
                android:id="@+id/heatmap_bar_6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/heatmap_bar_high" />
        </FrameLayout>

    </LinearLayout>

    <!-- Day labels row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:weightSum="7">

        <TextView
            android:id="@+id/heatmap_day_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#7A3D1F"
            android:textSize="8sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/heatmap_day_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#7A3D1F"
            android:textSize="8sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/heatmap_day_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#7A3D1F"
            android:textSize="8sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/heatmap_day_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#7A3D1F"
            android:textSize="8sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/heatmap_day_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#7A3D1F"
            android:textSize="8sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/heatmap_day_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#7A3D1F"
            android:textSize="8sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/heatmap_day_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TODAY"
            android:textColor="#F97316"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
