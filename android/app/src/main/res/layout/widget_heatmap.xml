<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_heatmap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📿 This Week"
            android:textColor="#F5A623"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heatmap_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D8B99A"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 7-day heatmap cells -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="7">

        <!-- Day 0 (oldest) -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <View android:id="@+id/heatmap_bar_0" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:background="#33FFFFFF" android:layout_marginBottom="3dp" />
            <TextView android:id="@+id/heatmap_day_0" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="#D8B99A" android:textSize="8sp" android:gravity="center" />
        </LinearLayout>

        <!-- Day 1 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <View android:id="@+id/heatmap_bar_1" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:background="#33FFFFFF" android:layout_marginBottom="3dp" />
            <TextView android:id="@+id/heatmap_day_1" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="#D8B99A" android:textSize="8sp" android:gravity="center" />
        </LinearLayout>

        <!-- Day 2 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <View android:id="@+id/heatmap_bar_2" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:background="#33FFFFFF" android:layout_marginBottom="3dp" />
            <TextView android:id="@+id/heatmap_day_2" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="#D8B99A" android:textSize="8sp" android:gravity="center" />
        </LinearLayout>

        <!-- Day 3 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <View android:id="@+id/heatmap_bar_3" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:background="#33FFFFFF" android:layout_marginBottom="3dp" />
            <TextView android:id="@+id/heatmap_day_3" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="#D8B99A" android:textSize="8sp" android:gravity="center" />
        </LinearLayout>

        <!-- Day 4 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <View android:id="@+id/heatmap_bar_4" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:background="#33FFFFFF" android:layout_marginBottom="3dp" />
            <TextView android:id="@+id/heatmap_day_4" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="#D8B99A" android:textSize="8sp" android:gravity="center" />
        </LinearLayout>

        <!-- Day 5 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <View android:id="@+id/heatmap_bar_5" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:background="#33FFFFFF" android:layout_marginBottom="3dp" />
            <TextView android:id="@+id/heatmap_day_5" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="#D8B99A" android:textSize="8sp" android:gravity="center" />
        </LinearLayout>

        <!-- Day 6 (today) -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <View android:id="@+id/heatmap_bar_6" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:background="#33FFFFFF" android:layout_marginBottom="3dp" />
            <TextView android:id="@+id/heatmap_day_6" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="TODAY"
                android:textColor="#F5A623" android:textSize="8sp" android:gravity="center"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
