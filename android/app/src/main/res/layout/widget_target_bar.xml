<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_target_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Top row: emoji + count label + percentage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📿"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/target_count_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="—  Navkars today"
                android:textColor="#FFF1E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/target_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#F97316"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ProgressBar — native RemoteViews supported, no layout trick needed -->
        <ProgressBar
            android:id="@+id/target_fill"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#F97316"
            android:progressBackgroundTint="#3D1F10" />

        <!-- Bottom: subtitle -->
        <TextView
            android:id="@+id/target_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Open app to begin your sadhana"
            android:textColor="#7A3D1F"
            android:textSize="9sp" />

    </LinearLayout>
</FrameLayout>
