<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_target_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:gravity="start">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/target_count_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="— Navkars today"
                android:textColor="#FBEEDD"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/target_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#F5A623"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress bar via two nested views -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:background="#33FFFFFF"
            android:clipChildren="true">

            <TextView
                android:id="@+id/target_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="#F5A623"
                android:text="" />
        </FrameLayout>

        <TextView
            android:id="@+id/target_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Open app to set a daily target"
            android:textColor="#D8B99A"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
