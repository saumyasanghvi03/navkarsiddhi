<?xml version="1.0" encoding="utf-8"?>
<actions>

    <!-- "Hey Google, add navkars in Navkar Siddhi" -->
    <action intentName="com.navkarsiddhi.app.ADD_NAVKARS">
        <fulfillment urlTemplate="navkarsiddhi://add{?count,malas}">
            <parameter-mapping
                intentParameter="count"
                urlParameter="count" />
            <parameter-mapping
                intentParameter="malas"
                urlParameter="malas" />
        </fulfillment>
        <!-- fallback: just open the app -->
        <fulfillment urlTemplate="navkarsiddhi://jaap" />
    </action>

    <!-- "Hey Google, how many navkars did I do today?" -->
    <action intentName="com.navkarsiddhi.app.GET_NAVKAR_COUNT">
        <fulfillment urlTemplate="navkarsiddhi://progress" />
    </action>

</actions>
